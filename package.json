{
  "name": "asap-vps",
  "version": "0.0.22",
  "description": "Library to help setup/deploy virtual private servers.",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "module": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -d",
    "test": "jest",
    "test:do": "ASAP_VPS_LIVE=digitalocean-vps jest --config jest.live.config.js DigitalOceanVps.live",
    "test:do:cpu": "ASAP_VPS_LIVE=digitalocean-cpu jest --config jest.live.config.js DigitalOceanCpu.live",
    "test:scw": "ASAP_VPS_LIVE=scaleway-vps jest --config jest.live.config.js ScalewayVps.live",
    "test:scw:cpu": "ASAP_VPS_LIVE=scaleway-cpu jest --config jest.live.config.js ScalewayCpu.live",
    "test:scw:volumes": "ASAP_VPS_LIVE=scaleway-vps jest --config jest.live.config.js ScalewayVolumes.live",
    "gpu:smoke": "ts-node --transpile-only scripts/gpu-smoke.ts",
    "test:live": "jest --config jest.live.config.js",
    "test:coverage": "jest --coverage --coverageDirectory=coverage --collectCoverageFrom='src/Providers/Scaleway/*.ts' --collectCoverageFrom='!**/*.spec.ts' src/Providers/Scaleway",
    "scaleway:spec": "ts-node --transpile-only scripts/scaleway-spec-check.ts",
    "api:spec": "ts-node --transpile-only scripts/api-spec-check.ts"
  },
  "dependencies": {
    "node-ssh": "^13.1.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/jest": "^29.5.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.3.1",
    "@types/node-ssh": "^7.0.2",
    "@types/ssh2": "^1.11.19",
    "dotenv": "^16.4.1",
    "jest": "^29.5.0",
    "js-yaml": "^4.3.2",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.3"
  },
  "jest": {
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "\\.live\\.spec\\.ts$"
    ],
    "coverageThreshold": {
      "./src/Providers/Scaleway/api.ts": {
        "statements": 100,
        "branches": 100,
        "functions": 100,
        "lines": 100
      },
      "./src/Providers/Scaleway/endpoints.ts": {
        "statements": 100,
        "branches": 100,
        "functions": 100,
        "lines": 100
      },
      "./src/Providers/Scaleway/types.ts": {
        "statements": 100,
        "branches": 100,
        "functions": 100,
        "lines": 100
      },
      "./src/Providers/Scaleway/Scaleway.ts": {
        "statements": 100,
        "branches": 100,
        "functions": 100,
        "lines": 100
      },
      "./src/Providers/Scaleway/mappers.ts": {
        "statements": 100,
        "branches": 100,
        "functions": 100,
        "lines": 100
      }
    }
  },
  "author": "visgotti",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
