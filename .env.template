# Copy to .env.test (gitignored) and fill in. Leave a provider empty to skip it.

# DigitalOcean (class DigitalOcean): droplets, with GPUs or without.
# Key: https://cloud.digitalocean.com/account/api/tokens -> Generate New Token (Full Access)
DIGITAL_OCEAN_API_KEY=dop_v1_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Every provider (src/Providers) reads its key from here: providersFromEnv(), the live suites,
# and the smoke test (npm run gpu:smoke -- <provider>), which rents and deletes a real GPU.

# RunPod (class RunPod). Key: https://console.runpod.io/user/credentials -> API Keys -> Create API Key (All)
RUNPOD_API_KEY=

# Vast.ai (class VastAI). Key: https://cloud.vast.ai/manage-keys/ -> API Keys -> +New
VAST_API_KEY=

# Lambda Cloud (class LambdaCloud). Key: https://cloud.lambda.ai/api-keys -> Generate API key
LAMBDA_API_KEY=

# Scaleway (class Scaleway): Instances, with GPUs or without. The SECRET key of an API key
# (the one sent as X-Auth-Token): https://console.scaleway.com/iam/api-keys
SCW_SECRET_KEY=
# Optional: the same API key's access key (SCW...). Only importImage and copyImage need it: they go through Object Storage.
SCW_ACCESS_KEY=
# The Project servers and SSH keys are created in (the console's Project settings). Needed to create anything.
SCW_DEFAULT_PROJECT_ID=
# Optional: only these zones, comma-separated (a region such as fr-par stands for its zones). Default: all of them.
SCW_ZONES=
